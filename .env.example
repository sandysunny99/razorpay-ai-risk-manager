# ============================================================
# Razorpay AI Risk Manager: Environment Configuration Example
# ============================================================

# Application Environment
APP_NAME="Razorpay AI Risk Manager Agent"
APP_MODE=demo
DRY_RUN=true
PORT=8000

# Cryptographic Keys (Manage via KMS / Vault in Production)
HMAC_SECRET_KEY=razorpay_risk_agent_hmac_secret_key_2026_demo
MASTER_ENCRYPTION_KEY=razorpay_risk_agent_master_aes256_gcm_secret_key_2026

# Database
DATABASE_URL=sqlite:///./risk_management.db

# Cloudflare Edge Perimeter (Optional)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Razorpay Test Mode Sandbox Credentials (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
