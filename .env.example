# ═══════════════════════════════════════════════════════════════
# Razorpay AI Risk Manager — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your environment.
# DRY_RUN=true is the DEFAULT — no real money is moved in demo mode.

# ── Core Application ────────────────────────────────────────────
APP_ENV=development          # development | production | testing
DRY_RUN=true                 # NEVER set false without reviewing LIVE_DEPLOYMENT_RUNBOOK.md
APP_MODE=demo                # demo | production

# ── Security Keys ────────────────────────────────────────────────
# REQUIRED in production. In demo/DRY_RUN mode, a random ephemeral
# key is generated at startup with a loud warning.
HMAC_SECRET_KEY=             # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Optional API authentication (mutation endpoints)
API_SECRET_KEY=              # generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── Database ──────────────────────────────────────────────────────
# SQLite for local dev. For production, use PostgreSQL from Render or Neon.
DATABASE_URL=sqlite:///./risk_manager.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── RAZORPAY TEST API (sandbox — no real money) ───────────────
# Generate at: dashboard.razorpay.com → Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=rzp_test_mock_agent_key   # Set your real rzp_test_... key
RAZORPAY_KEY_SECRET=rzp_test_mock_agent_secret
RAZORPAY_WEBHOOK_SECRET=                  # Webhook secret configured in Razorpay dashboard
USE_MOCK_RAZORPAY=true

# Test card numbers for manual & webhook simulation:
# SUCCESS: 4111 1111 1111 1111 (Visa) | 5267 3181 8797 5449 (Mastercard) | 3782 822463 10005 (Amex)
# DECLINE: 4000 0000 0000 0002 (Visa) | INSUFFICIENT_FUNDS: 4000 0000 0000 9995 (Visa)
# Test UPI: success@razorpay (pass) | failure@razorpay (fail)

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: Free API Integrations (Phase 2)
# All integrations degrade gracefully — demo works with no keys.
# ═══════════════════════════════════════════════════════════════

# ip-api.com — Real geo-deviation scoring
# No API key required. Free tier: 45 requests/minute.
# Automatically enabled when ENABLE_IP_GEO=true (default).
ENABLE_IP_GEO=true

# Have I Been Pwned v3 — Dark web breach correlation
# Get free key at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# AbuseIPDB — IP reputation scoring
# Get free key at: https://www.abuseipdb.com (1,000 checks/day free)
ABUSEIPDB_API_KEY=

# Upstash Redis — Multi-worker safe rate limiting
# Get free at: https://upstash.com (10,000 requests/day free)
# Without Redis, rate limiting is per-worker (in-memory, demo-safe).
# Format: rediss://default:TOKEN@ENDPOINT.upstash.io:6379
REDIS_URL=

# Sentry — Production error monitoring
# Get free at: https://sentry.io (5,000 events/month free)
# Without Sentry, errors are logged to uvicorn stdout only.
# Format: https://KEY@oXXXXX.ingest.sentry.io/PROJECT_ID
SENTRY_DSN=
