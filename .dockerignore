# .dockerignore — Razorpay AI Risk Manager
# Excludes development, evaluation, and secret files from the production Docker image.
# This reduces image size and prevents evaluation data / secrets from shipping to prod.
#
# IMPORTANT: .dockerignore patterns apply to the BUILD CONTEXT sent to the Docker daemon.
# The frontend Stage 1 build still needs frontend/src/, package.json etc. to compile.
# Only the final runner stage (Stage 2) should exclude those files — but since .dockerignore
# applies to the whole build context, we only exclude what Stage 1 doesn't need.

# ── Python artifacts ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
.Python
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Database files (never ship to production) ─────────────────
*.db
*.sqlite
*.sqlite3

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.*
*.pem
*.key
*.p12

# ── Git ───────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Evaluation data — not needed in any build stage ───────────
evaluation/

# ── Documentation (large, not needed at runtime) ──────────────
docs/

# ── Scripts (not needed in production image) ──────────────────
scripts/

# ── Frontend: only exclude node_modules (source files needed for Stage 1 build) ──
# Do NOT exclude frontend/src/, frontend/package.json, frontend/*.ts etc.
# Those are required by the frontend-builder stage to compile the React app.
frontend/node_modules/
frontend/dist/

# ── Development tools ─────────────────────────────────────────
.vscode/
.idea/
node_modules/
pyproject.toml
